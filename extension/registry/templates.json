      "files": [
        {
          "name": "elsarticle.cls",
          "action": "report-only",
          "versionFrom": "provides",
          "reason": "elsarticle is published on CTAN as elsarticle.dtx only; no compiled .cls is distributed anywhere, so it cannot be fetched and replaced safely.",
          "recommendation": "unbundle",
          "recommendationText": "Overleaf's TeX Live already carries a current elsarticle. Deleting the project-local elsarticle.cls lets that system copy take over, which is usually the fastest way to get the newer class.",
